#!/usr/bin/env bash
# Cyberpunk (vaporwave) sketchybar — entrypoint

export CONFIG_DIR="$HOME/.config/sketchybar"
export PLUGIN_DIR="$CONFIG_DIR/plugins"
export ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

# ============================================================================
# Bar
# ============================================================================
sketchybar --bar \
  height=37 \
  position=top \
  sticky=on \
  padding_left=15 \
  padding_right=15 \
  color=$BG_TRANSPARENT \
  border_width=0 \
  notch_width=200 \
  shadow=off \
  font_smoothing=on \
  y_offset=0

# ============================================================================
# Defaults
# ============================================================================
sketchybar --default \
  icon.font="JetBrains Mono:Bold:13.0" \
  icon.color=$FG \
  label.font="JetBrains Mono:Semibold:13.0" \
  label.color=$FG \
  background.color=$BG_TRANSPARENT \
  background.corner_radius=6 \
  background.height=24 \
  padding_left=4 \
  padding_right=4 \
  label.padding_left=4 \
  label.padding_right=4 \
  icon.padding_left=4 \
  icon.padding_right=4

# ============================================================================
# Custom events (must be registered before items subscribe to them)
# ============================================================================
sketchybar --add event aerospace_workspace_change

# ============================================================================
# Items
# ============================================================================
shopt -s nullglob
for item_file in "$ITEM_DIR"/*.sh; do
  source "$item_file"
done
shopt -u nullglob

# ============================================================================
# Bracket: workspaces panel grouping left-side items
# ============================================================================
sketchybar --add bracket workspaces \
  space.1 space.2 space.3 space.4 space.5 space.6 space.7 space.8 space.9 \
  space.A space.B space.C space.D space.E space.F space.G space.I \
  space.M space.N space.O space.P space.Q space.R space.S space.T \
  space.U space.V space.W space.X space.Y space.Z \
  front_app \
  --set workspaces \
    background.color=$BG_PANEL \
    background.corner_radius=8 \
    background.border_color=$BORDER \
    background.border_width=1 \
    background.height=28

# ============================================================================
# Bracket: status panel grouping right-side items
# ============================================================================
sketchybar --add bracket status \
  media cpu battery wifi volume clock \
  --set status \
    background.color=$BG_PANEL \
    background.corner_radius=8 \
    background.border_color=$BORDER \
    background.border_width=1 \
    background.height=28

sketchybar --update
